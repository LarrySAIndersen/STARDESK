# =====================================================================
# STARDESK — Environment variables
# =====================================================================
# Kopier denne fil til .env.local (frontend) eller .env (backend).
# Læg ALDRIG den udfyldte version i git - den er allerede gitignored.
# =====================================================================

# ---- Backend (apps/api) ----

# Neon connection string. Findes i Neon dashboard → "Connection string".
# VIGTIGT: Skift "postgresql://" til "postgresql+asyncpg://" for at virke
# med SQLAlchemy async.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Hvor er frontend deployet? Bruges til CORS-allowlist.
FRONTEND_URL=http://localhost:3000

# Mail (Resend) - opret konto gratis på resend.com, hent API key
RESEND_API_KEY=re_xxxxxxxxxxxxx
MAIL_FROM=noreply@stardesk-prototype.dk

# JWT secret til API-tokens (generér en tilfældig streng på 32+ tegn)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ---- Frontend (apps/web) ----

# URL til backend API (Railway deployment URL i prod)
NEXT_PUBLIC_API_URL=http://localhost:8000
