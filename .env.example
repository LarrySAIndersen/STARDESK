# =====================================================================
# STARDESK — Environment variables (local dev overview)
# =====================================================================
# Kopier denne fil til .env.local (frontend) eller .env (backend).
# Læg ALDRIG den udfyldte version i git - den er allerede gitignored.
#
# Cloud miljøer (test / prod / prod-klon):
#   docs/environments.md
#   apps/api/.env.test.example | .env.production.example | .env.prodclone.example
#   apps/web/.env.test.example | .env.production.example | .env.prodclone.example
# =====================================================================

# ---- Backend (apps/api) ----

# Neon connection string. Findes i Neon dashboard → "Connection string".
# VIGTIGT: Skift "postgresql://" til "postgresql+asyncpg://" for at virke
# med SQLAlchemy async.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Hvor er frontend deployet? Bruges til CORS-allowlist.
FRONTEND_URL=http://localhost:3000

# Mail (Resend) - opret konto gratis på resend.com, hent API key
RESEND_API_KEY=re_xxxxxxxxxxxxx
MAIL_FROM=noreply@stardesk-prototype.dk

# JWT secret til API-tokens (generér en tilfældig streng på 32+ tegn)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# development | production — i production kræves stærke JWT/CRON/WEBHOOK secrets (API nægter start ellers)
APP_ENV=development
CRON_SECRET=change-me-cron-secret
WEBHOOK_SECRET=change-me-webhook-secret

# Slack OAuth (one-time app setup in Slack API portal)
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/oauth/callback

# Optional local dev fallback without Slack app (0/1)
SLACK_MOCK=0

# Gmail OAuth
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/oauth/callback

# Gmail integration mode/options
GMAIL_MOCK=0
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_ALLOW_PLAINTEXT_TOKENS=1
# Expected connected mailbox (OAuth); used to validate connect + inbound filtering
GMAIL_SYNC_FROM_EMAIL=proto.star.itsm@gmail.com
# Optional RFC5322 From header when sending (display name + address)
# GMAIL_DEFAULT_FROM=STAR Service Desk / STARdesk <proto.star.itsm@gmail.com>

# ---- Frontend (apps/web) ----

# URL til backend API (Railway deployment URL i prod)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vis testbrugere på login: true = demo-picker, false = skjult, udeladt = kun i development
# Anbefaling Vercel production: false (eller udelad variablen)
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# Valgfri site-wide HTTP Basic Auth (staging lock på Vercel).
# Kun aktiv når BEGGE er sat; ellers springes Basic Auth over (fail-open).
# BASIC_AUTH_USER=stardesk
# BASIC_AUTH_PASSWORD=change-me-use-a-strong-random-password

# ---- Sonar agent (scripts/sonar-agent) ----
# SONAR_HOST_URL=https://sonarcloud.io
# SONAR_TOKEN=replace-me
# SONAR_PROJECT_KEY=your-org_your-project
# SONAR_BRANCH=main
# SONAR_PULL_REQUEST=
# SONAR_NEW_CODE_ONLY=1
