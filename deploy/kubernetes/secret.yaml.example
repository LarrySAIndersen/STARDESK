# Copy to secret.yaml, fill values, apply once — never commit real secrets.
#   kubectl apply -f deploy/kubernetes/secret.yaml -n stardesk
apiVersion: v1
kind: Secret
metadata:
  name: stardesk-secrets
  namespace: stardesk
  labels:
    app.kubernetes.io/part-of: stardesk
type: Opaque
stringData:
  # Neon — use postgresql+asyncpg://
  DATABASE_URL: "postgresql+asyncpg://USER:PASSWORD@HOST/neondb?sslmode=require"
  JWT_SECRET: "replace-with-long-random-string"
  CRON_SECRET: "replace-with-cron-secret"
  WEBHOOK_SECRET: "replace-with-webhook-secret"
  # Optional
  RESEND_API_KEY: ""
