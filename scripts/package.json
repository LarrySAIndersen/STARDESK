{
  "name": "stardesk-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "load-test": "node ./load-test/run-load-test.mjs baseline",
    "load-test:soak": "node ./load-test/run-load-test.mjs soak",
    "load-test:stress": "node ./load-test/run-load-test.mjs stress",
    "load-test:agent": "node ./load-test/run-load-agent.mjs",
    "load-test:destructive": "node ./load-test/run-destructive-agent.mjs",
    "load-test:destructive:spike": "node ./load-test/run-k6-destructive.mjs spike.js",
    "load-test:destructive:spike:smoke": "node ./load-test/run-k6-destructive.mjs spike.js --smoke",
    "load-test:destructive:aggressive": "node ./load-test/run-k6-destructive.mjs aggressive-scenarios.js",
    "test:destructive": "cd ../apps/api && pytest -m destructive tests/destructive -v",
    "security:audit": "node ./security-audit/run-audit.mjs",
    "sonar:agent": "node ./sonar-agent/run-sonar-agent.mjs",
    "sonar:sync-canvas": "node ./sonar-agent/sync-sonar-to-canvas.mjs",
    "sonar:sync-scheduler": "node ./sonar-agent/sync-scheduler-to-canvas.mjs",
    "sonar:pipeline": "node ./sonar-agent/run-sonar-pipeline.mjs",
    "sonar:hotspots": "node ./sonar-agent/fetch-sonar-hotspots.mjs",
    "sonar:hotspots:review": "node ./sonar-agent/review-sonar-hotspots.mjs",
    "sonar:scan": "node ./sonar-agent/run-sonar-scan.mjs",
    "sonar:agent:api": "node ./sonar-agent/run-sonar-agent.mjs api",
    "sonar:codemod:fastapi": "python ./sonar-agent/codemods/fastapi_router_style.py",
    "sonar:codemod:readonly-props": "node ./sonar-agent/codemods/react_readonly_props.mjs",
    "sonar:codemod:void-operator": "node ./sonar-agent/codemods/replace_void_operator.mjs",
    "quality:loop": "node ./n8n-workflows/run-quality-loop.mjs",
    "review:playwright": "node ./run-review-playwright.mjs",
    "review:playwright:import": "node ./import-playwright-evidence-to-workboard.mjs",
    "review:playwright:pipeline": "node ./run-review-playwright-pipeline.mjs",
    "review:playwright:trigger": "node ./trigger-review-playwright-on-board.mjs",
    "workboard:sync": "node ./migrate-workboard-json-to-db.mjs",
    "gate:hello-world": "bash ./hello-world-gate-api.sh",
    "gate:hello-world:ui": "node ./hello-world-gate.mjs",
    "gate:deliverable": "node ./run-deliverable-gate.mjs",
    "gate:deliverable:full": "node ./run-deliverable-gate.mjs --full",
    "gate:deliverable:staging": "node ./run-deliverable-gate.mjs --staging",
    "gate:deliverable:staging:full": "node ./run-deliverable-gate.mjs --staging --full",
    "watchdog": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./stardesk-watchdog.ps1 -Once",
    "watchdog:dry-run": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./stardesk-watchdog.ps1 -Once -DryRun",
    "watchdog:start": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./stardesk-watchdog.ps1",
    "watchdog:stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./stardesk-watchdog.ps1 -Stop",
    "sonar:loop-scheduler": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./sonar-agent/run-sonar-loop-scheduler.ps1",
    "sonar:loop-scheduler:start": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./sonar-agent/run-sonar-loop-scheduler.ps1 -Background",
    "sonar:loop-scheduler:stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./sonar-agent/run-sonar-loop-scheduler.ps1 -Stop",
    "sonar:scheduler-watchdog": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./sonar-agent/run-sonar-scheduler-watchdog.ps1 -Once",
    "sonar:scheduler-watchdog:start": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./sonar-agent/run-sonar-scheduler-watchdog.ps1 -Background",
    "sonar:scheduler-watchdog:stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./sonar-agent/run-sonar-scheduler-watchdog.ps1 -Stop",
    "sonar:loop:start": "npm run sonar:loop-scheduler:start && npm run sonar:scheduler-watchdog:start",
    "coverage:agent": "node ./coverage-agent/run-coverage-agent.mjs",
    "coverage:sync-canvas": "node ./coverage-agent/sync-coverage-to-canvas.mjs",
    "coverage:pipeline": "node ./coverage-agent/run-coverage-pipeline.mjs"
  },
  "devDependencies": {
    "playwright": "^1.55.1"
  }
}