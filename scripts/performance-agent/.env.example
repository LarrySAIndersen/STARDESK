# Performance agent env (optional — falls back to scripts/load-test/.env.loadtest)
# Copy to .env and edit.

# API target for JMeter agent
# BASE_URL=http://localhost:8000

# Web target for Playwright agent
# WEB_URL=http://localhost:3000
# STARDESK_WEB_URL=http://localhost:3000

# Demo login (Playwright)
# TEST_USER_EMAIL=sf01@example.dk
# TEST_USER_PASSWORD=

# JMeter tuning
# JMETER_DURATION_SECONDS=60
# JMETER_RAMP_SECONDS=10
# VUS=10

# Playwright tuning
# PW_PERF_ITERATIONS=1
# PLAYWRIGHT_HEADED=1

# Skip agents in swarm
# PERF_SKIP_JMETER=1
# PERF_SKIP_PLAYWRIGHT=1

# Canvas override
# PERF_CANVAS_DATA_PATH=
