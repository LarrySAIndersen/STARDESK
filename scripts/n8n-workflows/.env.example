# Copy to n8n credentials / host env (never commit secrets)

STARDESK_REPO=C:/Users/kjaer/STARDESK Cursor/STARDESK

# Sonar (required for Sonar phase)
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=replace-me
SONAR_PROJECT_KEY=your-org_your-project
SONAR_BRANCH=main
SONAR_NEW_CODE_ONLY=1
QUALITY_LOOP_SONAR_SCOPES=api

# Destructive (smoke by default)
ALLOW_DESTRUCTIVE=1
QUALITY_LOOP_DESTRUCTIVE=smoke
BASE_URL=http://localhost:8000
# QUALITY_LOOP_ALLOW_REMOTE=1

# Optional notification from n8n HTTP node
# QUALITY_LOOP_WEBHOOK_URL=https://hooks.slack.com/services/...
