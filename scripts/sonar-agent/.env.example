# SonarQube host URL (no trailing slash)
SONAR_HOST_URL=https://sonarcloud.io

# Personal Access Token from SonarQube/SonarCloud
SONAR_TOKEN=replace-me

# Project key as shown in Sonar
SONAR_PROJECT_KEY=your-org_your-project

# Optional: analyze branch or PR
# SONAR_BRANCH=main
# SONAR_PULL_REQUEST=123

# 1 = only "New Code" issues, 0 = all open issues
SONAR_NEW_CODE_ONLY=1
