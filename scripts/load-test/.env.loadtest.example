# Copy this file to .env.loadtest and edit values.
# Never commit real credentials.

# API base URL (staging/local preferred).
BASE_URL=http://localhost:8000

# Production (explicit approval; use ALLOW_DESTRUCTIVE=1 for destructive):
# BASE_URL=https://api-gamma-amber.vercel.app
# WEB_URL=https://web-seven-neon-6bvmcoel7n.vercel.app

# Optional web URL when testing BFF routes.
WEB_URL=http://localhost:3000

# Virtual users and pacing.
VUS=20
THINK_TIME_MS=150
SOAK_DURATION_SECONDS=300

# Stress test stages (seconds and VUs).
STRESS_STAGE_1_SECONDS=60
STRESS_STAGE_1_VUS=20
STRESS_STAGE_2_SECONDS=60
STRESS_STAGE_2_VUS=40
STRESS_STAGE_3_SECONDS=30
STRESS_STAGE_3_VUS=20

# Endpoint overrides (defaults target FastAPI routes).
LOGIN_PATH=/api/v1/auth/login
TICKETS_PATH=/api/v1/tickets
DASHBOARD_PATH=/api/v1/reports/dashboard
HEALTH_PATH=/health

# Thresholds used for pass/fail and CI exit code.
THRESHOLD_P95_MS=2000
THRESHOLD_ERROR_RATE_PCT=1

# Safety gate for destructive testing (required for non-local targets).
# ALLOW_DESTRUCTIVE=1

# User source (choose one):
# 1) JSON file path relative to scripts/load-test
LOAD_TEST_USERS_FILE=load-test-users.json
# 2) Inline JSON string (optional, overrides file)
# LOAD_TEST_USERS=[{"email":"user@example.com","password":"secret"}]
