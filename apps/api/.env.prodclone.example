# STARdesk API — PROD-CLONE (UAT: prod-like secrets, isolated Neon branch "prod-clone")
# Duplicate Vercel project "api-prodclone". Override ONLY DATABASE_URL and FRONTEND_URL vs prod.

APP_ENV=production

DATABASE_URL=postgresql+asyncpg://user:password@ep-prodclone-xxx.region.aws.neon.tech/neondb?sslmode=require

FRONTEND_URL=https://YOUR-WEB-PRODCLONE.vercel.app

# Copy JWT_SECRET, CRON_SECRET, WEBHOOK_SECRET, RESEND_*, integration keys FROM production
JWT_SECRET=same-as-production-only-for-uat
CRON_SECRET=same-as-production-only-for-uat
WEBHOOK_SECRET=same-as-production-only-for-uat

RESEND_API_KEY=
MAIL_FROM=

# Update OAuth redirect URIs in provider consoles to prodclone web URL
SLACK_REDIRECT_URI=https://YOUR-WEB-PRODCLONE.vercel.app/api/integrations/slack/oauth/callback
GMAIL_REDIRECT_URI=https://YOUR-WEB-PRODCLONE.vercel.app/api/integrations/gmail/oauth/callback
