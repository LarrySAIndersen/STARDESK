# STARdesk API — TEST environment (Preview / web-test + api-test)
# Copy to .env.local for local test against Neon "test" branch. Never commit filled values.

APP_ENV=development

DATABASE_URL=postgresql+asyncpg://user:password@ep-test-xxx.region.aws.neon.tech/neondb?sslmode=require

# Set after web-test is deployed (comma-separated origins OK)
FRONTEND_URL=https://YOUR-WEB-TEST.vercel.app,http://localhost:3000

JWT_SECRET=use-a-different-secret-than-production

CRON_SECRET=test-cron-secret
WEBHOOK_SECRET=test-webhook-secret

RESEND_API_KEY=
MAIL_FROM=noreply@test.stardesk.example

UPLOAD_DIR=/tmp/stardesk-uploads

# Prefer test Slack/Google apps with callbacks on test web URL
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=https://YOUR-WEB-TEST.vercel.app/api/integrations/slack/oauth/callback
SLACK_MOCK=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://YOUR-WEB-TEST.vercel.app/api/integrations/gmail/oauth/callback
GMAIL_MOCK=1
GMAIL_ALLOW_PLAINTEXT_TOKENS=1
GMAIL_SYNC_FROM_EMAIL=
