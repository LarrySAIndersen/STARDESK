# Local dev — see docs/environments.md for test / prod / prod-klon templates.
# Neon — use postgresql+asyncpg:// (not postgresql://)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# development | production — production requires strong JWT/CRON/WEBHOOK secrets
APP_ENV=development

# Frontend origin for CORS (Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Mail (Resend) — used in later prompts
RESEND_API_KEY=re_xxxxxxxxxxxxx
MAIL_FROM=noreply@stardesk-prototype.dk

# JWT for API tokens
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Optional: bootstrap hash for prototype staff users (bcrypt hash string).
# Keep empty to avoid automatic password overwrite in app runtime.
PROTOTYPE_STAFF_PASSWORD_HASH=

# Vercel Cron (Authorization: Bearer … on /api/v1/cron/sla-check)
CRON_SECRET=change-me-cron-secret

# Uploaded files — local dev only (/tmp on Vercel is ephemeral; use Blob in prod)
UPLOAD_DIR=/tmp/stardesk-uploads

# Vercel Blob (required on Vercel API for ticket attachments — Hobby free tier)
# Create store in Vercel → Storage → Blob → connect to api project
BLOB_READ_WRITE_TOKEN=
# Auto-set when Blob store is connected to the api project (optional fallback: parsed from token)
BLOB_STORE_ID=
# Match Vercel Blob store: private (default) or public
BLOB_ACCESS=private

# Email webhook (header X-Webhook-Secret)
WEBHOOK_SECRET=change-me-webhook-secret

# Slack OAuth (one-time app setup in Slack API portal)
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/oauth/callback

# Optional local dev fallback without Slack app (0/1)
SLACK_MOCK=0

# Gmail OAuth
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/oauth/callback

# Gmail integration mode/options
GMAIL_MOCK=0
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_ALLOW_PLAINTEXT_TOKENS=1
GMAIL_SYNC_FROM_EMAIL=proto.star.itsm@gmail.com
# GMAIL_DEFAULT_FROM=STAR Service Desk / STARdesk <proto.star.itsm@gmail.com>
