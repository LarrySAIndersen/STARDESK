# Neon — use postgresql+asyncpg:// (not postgresql://)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Frontend origin for CORS (Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Mail (Resend) — used in later prompts
RESEND_API_KEY=re_xxxxxxxxxxxxx
MAIL_FROM=noreply@stardesk-prototype.dk

# JWT — used when auth is added
JWT_SECRET=change-me-in-production-use-a-long-random-string
