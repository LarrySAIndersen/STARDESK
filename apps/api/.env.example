# Neon — use postgresql+asyncpg:// (not postgresql://)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Frontend origin for CORS (Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Mail (Resend) — used in later prompts
RESEND_API_KEY=re_xxxxxxxxxxxxx
MAIL_FROM=noreply@stardesk-prototype.dk

# JWT — used when auth is added
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Vercel Cron (Authorization: Bearer … on /api/v1/cron/sla-check)
CRON_SECRET=change-me-cron-secret

# Uploaded files (use /tmp on Vercel; persistent volume on Railway)
UPLOAD_DIR=/tmp/stardesk-uploads

# Email webhook (header X-Webhook-Secret)
WEBHOOK_SECRET=change-me-webhook-secret

# Slack OAuth (one-time app setup in Slack API portal)
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/oauth/callback

# Optional local dev fallback without Slack app (0/1)
SLACK_MOCK=0
