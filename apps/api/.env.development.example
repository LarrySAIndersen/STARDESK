# STARdesk API — LOCAL DEVELOPMENT (mirrors production variable names, not values)
# Copy: cp apps/api/.env.development.example apps/api/.env
# Prod reference: apps/api/.env.production.example · deploy/vercel/env-manifest.json

STARDESK_ENV=development
APP_ENV=development

# Local Postgres (bootstrap-dev-database.sh --local-postgres) or Neon test branch
DATABASE_URL=postgresql+asyncpg://stardesk:stardesk_dev@localhost:5432/stardesk

FRONTEND_URL=http://localhost:3000

# Dev-only JWT (API falls back if unset; never use in production)
JWT_SECRET=local-development-only-jwt-secret-do-not-use-in-production

CRON_SECRET=dev-cron-secret
WEBHOOK_SECRET=dev-webhook-secret

RESEND_API_KEY=
MAIL_FROM=noreply@stardesk-prototype.dk

UPLOAD_DIR=/tmp/stardesk-uploads

SLACK_MOCK=1
GMAIL_MOCK=1
GMAIL_ALLOW_PLAINTEXT_TOKENS=1

# Production uses real OAuth (SLACK_MOCK=0). Uncomment when testing integrations locally:
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/oauth/callback
