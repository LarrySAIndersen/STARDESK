# STARdesk API — PRODUCTION (Vercel project "api", Neon branch "main")
# Reference only — set values in Vercel Dashboard → Production. Never commit secrets.

APP_ENV=production

DATABASE_URL=postgresql+asyncpg://user:password@ep-prod-xxx.region.aws.neon.tech/neondb?sslmode=require

FRONTEND_URL=https://web-seven-neon-6bvmcoel7n.vercel.app

JWT_SECRET=generate-32-plus-random-chars

CRON_SECRET=required-when-APP_ENV-production
WEBHOOK_SECRET=required-when-APP_ENV-production

RESEND_API_KEY=
MAIL_FROM=noreply@your-verified-domain

UPLOAD_DIR=/tmp/stardesk-uploads
# Required on Vercel API project for ticket attachments (serverless has no persistent local disk).
# Create a Blob store in Vercel → link to the "api" project → BLOB_READ_WRITE_TOKEN is auto-added.
BLOB_READ_WRITE_TOKEN=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=https://web-seven-neon-6bvmcoel7n.vercel.app/api/integrations/slack/oauth/callback
SLACK_MOCK=0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://web-seven-neon-6bvmcoel7n.vercel.app/api/integrations/gmail/oauth/callback
GMAIL_MOCK=0
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_ALLOW_PLAINTEXT_TOKENS=0
GMAIL_SYNC_FROM_EMAIL=
GMAIL_DEFAULT_FROM=
