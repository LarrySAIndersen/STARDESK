# Local dev — cloud targets: docs/environments.md (apps/web/.env.test.example, etc.)
# Backend API URL (Vercel API URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo login: staff land on / or /classic; /skift-adgangskode is voluntary (profile link).
# New passwords: min 8 chars, letters and digits only (no special characters).

# Optional site-wide HTTP Basic Auth (Vercel staging lock).
# Enforced only when BOTH are set; omit both for normal JWT/demo login.
# BASIC_AUTH_USER=stardesk
# BASIC_AUTH_PASSWORD=change-me-use-a-strong-random-password
