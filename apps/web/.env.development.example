# STARdesk Web — LOCAL DEVELOPMENT (mirrors production variable names, not values)
# Copy: cp apps/web/.env.development.example apps/web/.env.local
# Prod reference: apps/web/.env.production.example

# development = localhost only; test = Neon test branch (sync-neon-env.sh sets test)
NEXT_PUBLIC_STARDESK_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
NEXT_PUBLIC_PROTOTYPE_BOOTSTRAP_PASSWORD=Stardesk2026!

# Production: NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false (or omitted)
# Prod-clone / test may use BASIC_AUTH_* — omit locally unless testing staging lock
