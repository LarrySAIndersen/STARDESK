# STARdesk Web — TEST environment
# Vercel Preview (staging) or project "web-test". Never commit filled secrets.

NEXT_PUBLIC_API_URL=https://YOUR-API-TEST.vercel.app

# Demo login picker on /login
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
NEXT_PUBLIC_PROTOTYPE_BOOTSTRAP_PASSWORD=Stardesk2026!

# Recommended lock on shared test URL
BASIC_AUTH_USER=stardesk-test
BASIC_AUTH_PASSWORD=change-me-strong-random

# Server-side web → API (Vercel Deployment Protection on api Preview).
# Copy from Vercel → api → Deployment Protection → Protection Bypass for Automation.
# Do NOT use web's VERCEL_AUTOMATION_BYPASS_SECRET — that only bypasses web, not api.
VERCEL_PROTECTION_BYPASS=
